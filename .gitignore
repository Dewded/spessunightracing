# Repository-wide generated and private inputs.
#
# Machine-specific files belong in `.git/info/exclude`.
/build/
/build-*/
/cmake-build-*/
/dist/
/debug/

# User-supplied retail game files. Commit descriptors and hashes, never binaries.
/assets/

# Local matching experiments and caches.
/.cache/

# Runtime state.
/memcards/
*.log

# Special Nights stats (keep your own backups; never commit the group's data).
/special_nights.db
/special_nights.db-journal
/special_nights_players.txt

# play.bat: last race picked, and personal game options.
/.play-last.cmd
/play-options.txt

# Compiler outputs.
*.exe
*.o
*.gch
*.a
*.obj
*.pdb
*.ilk
*.d
*.depend
*.map
compile_commands.json

# Language and editor state.
.venv/
__pycache__/
*.py[cod]
.vs/
.idea/
*.swp
*~
